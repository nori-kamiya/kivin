{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "outDir": "../../.cache/lib-esnext-tests",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "lib": ["ESNext"],
    "types": ["bun-types", "node"],
    "skipLibCheck": false
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/decorators" },
    { "path": "../../packages/logger" },
    { "path": "../../packages/openapi" },
    { "path": "../../packages/valibot" },
    { "path": "../../packages/standard-schema" },
    { "path": "../../packages/jwt" },
    { "path": "../../packages/security" },
    { "path": "../../packages/http" },
    { "path": "../../packages/static" },
    { "path": "../../packages/graphql" },
    { "path": "../../packages/session" },
    { "path": "../../packages/schedule" },
    { "path": "../../packages/config" },
    { "path": "../../packages/observability" },
    { "path": "../../packages/cli" }
  ],
  "include": ["*.ts", "../../examples/basic/src/**/*.ts", "../../examples/basic/.kivin/generated/**/*.ts", "../../examples/basic/.kivin/generated/**/*.json"]
}
