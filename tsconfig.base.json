{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@kivinjs/core": ["./packages/core/src/index.ts"],
      "@kivinjs/decorators": ["./packages/decorators/src/index.ts"],
      "@kivinjs/logger": ["./packages/logger/src/index.ts"],
      "@kivinjs/openapi": ["./packages/openapi/src/index.ts"],
      "@kivinjs/valibot": ["./packages/valibot/src/index.ts"],
      "@kivinjs/standard-schema": ["./packages/standard-schema/src/index.ts"],
      "@kivinjs/jwt": ["./packages/jwt/src/index.ts"],
      "@kivinjs/security": ["./packages/security/src/index.ts"],
      "@kivinjs/http": ["./packages/http/src/index.ts"],
      "@kivinjs/static": ["./packages/static/src/index.ts"],
      "@kivinjs/graphql": ["./packages/graphql/src/index.ts"],
      "@kivinjs/session": ["./packages/session/src/index.ts"],
      "@kivinjs/schedule": ["./packages/schedule/src/index.ts"],
      "@kivinjs/config": ["./packages/config/src/index.ts"],
      "@kivinjs/observability": ["./packages/observability/src/index.ts"],
      "@kivinjs/cli": ["./packages/cli/src/index.ts"]
    },
    "lib": ["ES2022", "ESNext.Decorators", "DOM", "DOM.Iterable"],
    "types": ["node", "bun-types"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
