{
  "name": "@kivin/graphql",
  "version": "0.0.1",
  "description": "Mount GraphQL Yoga (or any fetch-based GraphQL server) on kivin native routes",
  "license": "MIT",
  "author": "nori-kamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nori-kamiya/kivin.git",
    "directory": "packages/graphql"
  },
  "homepage": "https://github.com/nori-kamiya/kivin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@kivin/core": "workspace:^"
  },
  "devDependencies": {
    "@kivin/core": "workspace:*",
    "graphql": "^17.1.0",
    "graphql-ws": "^6.4.1",
    "graphql-yoga": "^6.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "bugs": {
    "url": "https://github.com/nori-kamiya/kivin/issues"
  },
  "keywords": [
    "kivin",
    "bun",
    "web-framework",
    "graphql",
    "graphql-yoga"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
