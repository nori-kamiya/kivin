{
  "name": "@kivinjs/observability",
  "version": "0.1.0",
  "description": "Observability for kivin: OpenTelemetry tracing, Prometheus metrics, Server-Timing and health checks",
  "license": "MIT",
  "author": "nori-kamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nori-kamiya/kivin.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/nori-kamiya/kivin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@kivinjs/core": "workspace:^"
  },
  "devDependencies": {
    "@kivinjs/core": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "bugs": {
    "url": "https://github.com/nori-kamiya/kivin/issues"
  },
  "keywords": [
    "kivin",
    "bun",
    "web-framework",
    "observability",
    "opentelemetry",
    "prometheus",
    "metrics",
    "health-check"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
