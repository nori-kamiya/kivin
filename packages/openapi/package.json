{
  "name": "@kivin/openapi",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 document generation for kivin",
  "license": "MIT",
  "author": "nori-kamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nori-kamiya/kivin.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/nori-kamiya/kivin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@kivin/core": "workspace:^"
  },
  "devDependencies": {
    "@kivin/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "bugs": {
    "url": "https://github.com/nori-kamiya/kivin/issues"
  },
  "keywords": [
    "kivin",
    "bun",
    "web-framework",
    "openapi",
    "swagger"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
