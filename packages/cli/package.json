{
  "name": "@kivinjs/cli",
  "version": "0.1.0",
  "description": "Manifest and OpenAPI code-generation CLI for kivin",
  "license": "MIT",
  "author": "nori-kamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nori-kamiya/kivin.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nori-kamiya/kivin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kivin": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@kivinjs/openapi": "workspace:^",
    "oxc-parser": "0.155.0",
    "oxc-resolver": "11.24.2"
  },
  "peerDependencies": {
    "@kivinjs/core": "workspace:^"
  },
  "devDependencies": {
    "@kivinjs/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "bugs": {
    "url": "https://github.com/nori-kamiya/kivin/issues"
  },
  "keywords": [
    "kivin",
    "bun",
    "web-framework",
    "cli",
    "codegen",
    "openapi"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
