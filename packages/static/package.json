{
  "name": "@kivin/static",
  "version": "0.0.1",
  "description": "Static file serving for kivin on Bun native routes",
  "license": "MIT",
  "author": "nori-kamiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nori-kamiya/kivin.git",
    "directory": "packages/static"
  },
  "homepage": "https://github.com/nori-kamiya/kivin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@kivin/http": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
